---
import { appStoreUrl } from '../config';
interface Props { id: string }
const { id } = Astro.props;
---
<a class="store-btn" href={appStoreUrl(id)} aria-label="Download on the App Store">
  <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
  <span class="t"><span class="s">Download on the</span><span class="b">App Store</span></span>
</a>
<style>
  .store-btn { display: inline-flex; align-items: center; gap: 12px; min-height: 52px; padding: 8px 22px; border-radius: 14px; background: var(--invert); color: var(--on-invert); transition: transform 0.2s, opacity 0.2s; }
  .store-btn:hover { color: var(--on-invert); opacity: 0.9; transform: translateY(-1px); }
  .t { display: flex; flex-direction: column; line-height: 1.15; }
  .s { font-size: 11px; font-weight: 500; }
  .b { font-size: 18px; font-weight: 700; }
</style>
