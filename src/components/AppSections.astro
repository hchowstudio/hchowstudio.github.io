---
// Everything below an app's hero: description, screenshots, FAQ, CTA.
// Shared by the Markdown template and hand-made landing pages.
import { render, type CollectionEntry } from 'astro:content';
import Phone from './Phone.astro';
import AppStoreButton from './AppStoreButton.astro';

interface Props { app: CollectionEntry<'apps'>; showDescription?: boolean }
const { app, showDescription = true } = Astro.props;
const d = app.data;
const { Content } = await render(app);
const faq = [
  ...d.faq,
  { q: 'How do I restore a purchase?', a: 'Open the app’s settings and tap Restore Purchases while signed in with the same Apple ID you used to buy.' },
  { q: 'Where can I get help?', a: 'Use the Support link below — your email opens with the app name already filled in.' },
];
---
{showDescription && (
  <section class="section surface">
    <div class="container about">
      <div class="about-head reveal">
        <p class="eyebrow" style="color: var(--accent)">About the app</p>
        <h2 class="h2">{d.tagline}</h2>
      </div>
      <div class="prose desc reveal"><Content /></div>
    </div>
  </section>
)}

{d.screenshots.length > 0 && (
  <section class="section">
    <div class="container shots-head">
      <h2 class="h2">See it in action</h2>
      <p class="muted">Scroll through the screens</p>
    </div>
    <div class="shots" tabindex="0" aria-label={`${d.shortName} screenshots`}>
      {d.screenshots.map((s, i) => <Phone src={s} alt={`${d.shortName} screenshot ${i + 1}`} width={250} />)}
    </div>
  </section>
)}

<section class="section surface">
  <div class="container faq-wrap">
    <h2 class="h2" style="text-align:center">Questions</h2>
    <div class="faqs">
      {faq.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container end reveal">
    <img src={d.icon} alt="" width="88" height="88" />
    <h2 class="display end-title">Get {d.shortName}.</h2>
    <p class="muted">{d.price} · {d.platforms.join(' & ')}{d.ageRating ? ` · Ages ${d.ageRating}` : ''}</p>
    <AppStoreButton id={d.appStoreId} />
    <nav class="app-links" aria-label={`${d.shortName} links`}>
      <a href={`/apps/${app.id}/privacy/`}>Privacy Policy</a>
      <a href={`/contact/?app=${app.id}`}>Support</a>
      <a href="/#apps">More apps</a>
    </nav>
  </div>
</section>

<style>
  .about { display: flex; flex-wrap: wrap; gap: 48px; }
  .about-head { flex: 1 1 320px; display: flex; flex-direction: column; gap: 12px; align-self: flex-start; }
  .desc { flex: 999 1 520px; min-width: 0; }
  .desc :global(h3:first-child) { margin-top: 0; }
  .desc :global(p:first-child) { margin-top: 0; font-size: 20px; color: var(--text); }
  .shots-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px; margin-bottom: 40px; }
  .shots-head p { margin: 0; }
  .shots { display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px max(24px, calc((100vw - var(--max)) / 2 + 24px)) 32px; scrollbar-width: thin; }
  .shots > :global(*) { scroll-snap-align: start; }
  .faq-wrap { max-width: 820px; display: flex; flex-direction: column; gap: 32px; }
  .faqs { display: flex; flex-direction: column; gap: 12px; }
  .end { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; }
  .end img { width: 88px; height: 88px; border-radius: 20px; }
  .end-title { font-size: clamp(36px, 5vw, 56px); }
  .end p { margin: 0; }
  .app-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; margin-top: 12px; font-size: 15px; font-weight: 500; }
</style>
