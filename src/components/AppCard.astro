---
import type { CollectionEntry } from 'astro:content';
interface Props { app: CollectionEntry<'apps'> }
const { app } = Astro.props;
const d = app.data;
---
<a href={`/apps/${app.id}/`} class="app-card card" data-category={d.category}>
  <div class="top">
    <img class="icon" src={d.icon} alt="" width="56" height="56" loading="lazy" />
    <span class="pill">{d.category}</span>
  </div>
  <div>
    <h3>{d.shortName}</h3>
    <p>{d.tagline}</p>
  </div>
  <span class="more">View app →</span>
</a>
<style>
  .app-card { display: flex; flex-direction: column; gap: 16px; padding: 24px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface-2); color: var(--text); }
  .app-card:hover { color: var(--text); }
  .app-card[hidden] { display: none; }
  .top { display: flex; align-items: center; justify-content: space-between; }
  .icon { width: 56px; height: 56px; border-radius: 13px; box-shadow: 0 0 0 1px var(--line); }
  h3 { margin: 0; font-size: 18px; font-weight: 700; letter-spacing: -0.015em; }
  p { margin: 6px 0 0; font-size: 15px; line-height: 1.45; color: var(--muted); }
  .more { margin-top: auto; font-size: 14px; font-weight: 600; color: var(--accent); }
</style>
