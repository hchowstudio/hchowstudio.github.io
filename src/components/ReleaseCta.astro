---
// App Store button for live apps; a "Coming soon" badge before launch.
import type { App } from '../lib/apps';
import AppStoreButton from './AppStoreButton.astro';
interface Props { app: App }
const { app } = Astro.props;
const d = app.data;
---
{d.status === 'live' && d.appStoreId ? (
  <AppStoreButton id={d.appStoreId} />
) : (
  <span class="soon">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
    Coming soon to the App Store
  </span>
)}
<style>
  .soon { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px; border-radius: 14px; border: 1px dashed var(--line-strong); color: var(--text); font-weight: 600; }
</style>
