---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1 class="display">This page wandered off.</h1>
    <p class="lead">The link may be old or mistyped.</p>
    <div class="row"><a class="btn btn-primary" href="/">Go home</a><a class="btn btn-soft" href="/contact/">Contact support</a></div>
  </section>
</Base>
<style>
  .nf { padding-top: 140px; padding-bottom: 160px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; }
  h1 { font-size: clamp(40px, 6vw, 72px); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>
